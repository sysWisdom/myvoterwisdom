# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pyo

# Virtual environment
venv/
env/
.venv/

# Environment / secrets — NEVER commit credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Logs and temporary files
*.log
*.tmp

# System files
.DS_Store
Thumbs.db

# Runtime output — regenerated on each run
results.json

# Binary / large data artifacts — regenerate locally
*.index
model/
*.pkl
*.joblib

# CSV files — block accidental commits of generated/temp CSVs
*.csv
# Re-allow curated data files in data/ — these are tracked and
# protected by the Data Quality GitHub Actions gate on every PR
!data/*.csv
!data/reasoning/*.csv

# Node.js dependencies
node_modules/

# IDE
.vscode/settings.json